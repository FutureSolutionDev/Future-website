# Copy to .env.local for local builds.
# In CI these come from GitHub repository Variables (see .github/workflows/deploy.yml).

# Web3Forms access key — contact form delivery (https://web3forms.com, free)
NEXT_PUBLIC_WEB3FORMS_KEY=

# GA4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Search engine / domain ownership verification tokens (token only, not the full meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=
